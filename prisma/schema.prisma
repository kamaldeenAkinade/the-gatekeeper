generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  sessionVersion Int      @default(1)
  createdAt      DateTime @default(now())
}

model PendingUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  token     String
  createdAt DateTime @default(now())
}
